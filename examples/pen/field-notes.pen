{
  "version": "2.21",
  "variables": {
    "ink": { "type": "color", "value": "#173f35" },
    "muted": { "type": "color", "value": "#53695c" },
    "paper": { "type": "color", "value": "#f7f5ec" },
    "accent": { "type": "color", "value": "#c8e6c1" },
    "space": { "type": "number", "value": 16 }
  },
  "divlet": { "name": "Field notes · native" },
  "children": [
    {
      "id": "stamp", "type": "frame", "name": "Stamp · reusable", "reusable": true,
      "x": 400, "y": 0, "width": 160, "height": 28,
      "layout": "vertical", "alignItems": "center", "justifyContent": "center",
      "fill": "$accent", "cornerRadius": 14,
      "children": [
        { "id": "stamp-label", "type": "text", "content": "NATIVE PEN", "fontSize": 10, "fontWeight": "700", "lineHeight": 1.4, "fill": "$ink" }
      ]
    },
    {
      "id": "field-note", "type": "frame", "name": "Field notes", "x": 0, "y": 0,
      "width": 360, "height": 620, "layout": "vertical", "padding": 24, "gap": "$space", "fill": "$paper",
      "divlet": { "tag": "main" },
      "children": [
        { "id": "edition", "type": "ref", "ref": "stamp", "descendants": { "stamp-label": { "content": "FIELD NOTES / 01" } } },
        { "id": "headline", "type": "text", "width": "fill_container", "height": "fit_content", "content": "Small source.\nLong journey.", "fontSize": 34, "fontWeight": "600", "lineHeight": 1.08, "fill": "$ink", "divlet": { "tag": "h1" } },
        { "id": "intro", "type": "text", "width": "fill_container", "height": "fit_content", "content": "A native canvas with local artwork,\nshared details and a portable build.", "fontSize": 14, "lineHeight": 1.5, "fill": "$muted", "divlet": { "tag": "p" } },
        { "id": "landscape", "type": "rectangle", "name": "Local landscape", "width": "fill_container", "height": 168, "cornerRadius": 16, "fill": [{ "type": "image", "url": "assets/field.svg", "mode": "cover" }], "divlet": { "attrs": { "role": "img", "aria-label": "Geometric green hills and a warm sun, from a local SVG" } } },
        {
          "id": "description", "type": "frame", "width": "fill_container", "height": "fit_content", "layout": "vertical", "gap": 8,
          "children": [
            { "id": "eyebrow", "type": "text", "content": "DESIGNED TO TRAVEL", "fontSize": 10, "fontWeight": "700", "lineHeight": 1.4, "fill": "$ink" },
            { "id": "body", "type": "text", "width": "fill_container", "height": "fit_content", "content": "Edit one source. Keep the reference.\nTake the build anywhere.", "fontSize": 14, "lineHeight": 1.5, "fill": "$muted", "divlet": { "tag": "p" } }
          ]
        },
        { "id": "portable", "type": "ref", "ref": "stamp", "descendants": { "stamp-label": { "content": "LOCAL BY DESIGN" } } },
        { "id": "footer", "type": "text", "width": "fill_container", "height": "fit_content", "content": "No remote fonts. No outside grants.", "fontSize": 11, "lineHeight": 1.4, "fill": "$muted", "divlet": { "tag": "p" } }
      ]
    }
  ]
}
