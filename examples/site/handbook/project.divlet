{
  "schemaVersion": 2,
  "name": "divlet site example",
  "version": 2,
  "tokens": {},
  "css": "",
  "metadata": {},
  "frames": [
    {
      "id": "docs-template",
      "name": "Fieldnotes · shared template",
      "version": 1,
      "artboard": {
        "x": 80,
        "y": 80,
        "width": 1120,
        "height": 980
      },
      "rootId": "fieldnotes-root",
      "tokens": {},
      "css": "\n:root{color-scheme:light}\n*{box-sizing:border-box}\n.fieldnotes{min-height:100vh;background:#fbfaf7;color:#243447;font:16px/1.7 system-ui,sans-serif}\n.site-header{height:84px;display:flex;align-items:center;justify-content:space-between;padding:0 clamp(24px,5vw,72px);border-bottom:1px solid #e3e5e6;background:#fffefa}\n.site-brand{display:flex;align-items:center;gap:12px;color:#172b43;text-decoration:none;font-weight:740;letter-spacing:-.04em;font-size:21px}\n.site-brand img{width:32px;height:32px}\n.site-label{font-size:11px;font-weight:650;letter-spacing:.12em;text-transform:uppercase;color:#7c8997}\n.site-shell{display:grid;grid-template-columns:240px minmax(0,1fr);max-width:1216px;margin:auto;min-height:calc(100vh - 84px)}\n.site-sidebar{padding:48px 28px 40px 36px;border-right:1px solid #e3e5e6}\n.nav-label{margin:0 0 20px;color:#8a95a0;font-size:10px;font-weight:750;letter-spacing:.16em;text-transform:uppercase}\n.site-navigation ul{list-style:none;margin:0;padding:0}\n.site-navigation ul ul{margin:8px 0 16px;padding-left:14px;border-left:1px solid #d9e0e7}\n.site-navigation li{margin:7px 0}\n.site-navigation a{color:#63758a;text-decoration:none;font-size:13px;line-height:1.6;display:block;padding:3px 0}\n.site-navigation a:hover{color:#172b43;text-decoration:underline;text-underline-offset:4px}\n.site-navigation a[aria-current=\"page\"]{color:#172b43;font-weight:700}\n.sidebar-note{margin-top:48px;color:#96a0aa;font-size:11px;line-height:1.7}\n.site-main{min-width:0;padding:54px clamp(28px,5vw,76px) 64px}\n.page-eyebrow{display:flex;align-items:center;gap:9px;color:#a27b45;font-size:10px;font-weight:750;letter-spacing:.14em;text-transform:uppercase;margin:0 0 14px}\n.page-eyebrow span{display:block;width:20px;height:1px;background:#b89868}\n.page-title{font-size:clamp(31px,4vw,46px);line-height:1.15;letter-spacing:-.05em;font-weight:690;color:#172b43;margin:0 0 32px;max-width:680px}\n.page-content{max-width:720px;color:#596b7f;font-size:15px;line-height:1.85;overflow-wrap:anywhere}\n.page-content>p:first-child{font-size:17px;line-height:1.8;color:#6b7b8d;margin-bottom:28px}\n.page-content h1,.page-content h2,.page-content h3{color:#24384e;letter-spacing:-.025em;line-height:1.35;scroll-margin-top:24px}\n.page-content h1{font-size:30px}.page-content h2{font-size:21px;margin:38px 0 12px}.page-content h3{font-size:17px;margin:28px 0 10px}\n.page-content p{margin:0 0 18px}.page-content strong{color:#344c65;font-weight:650}\n.page-content a{color:#386b9c;text-decoration:underline;text-decoration-color:#c3d3e2;text-underline-offset:3px}\n.page-content a:hover{color:#172b43;text-decoration-color:currentColor}\n.page-content ul,.page-content ol{padding-left:22px;margin:0 0 22px}.page-content li{padding-left:3px;margin:7px 0}\n.page-content blockquote{margin:28px 0;padding:10px 22px;border-left:3px solid #c6ab85;background:#f3f0e9;color:#7a776f;border-radius:0 8px 8px 0}.page-content blockquote p{margin:0}\n.page-content table{border-collapse:collapse;width:100%;margin:22px 0 28px;font-size:13px}.page-content th{text-align:left;color:#53677d;background:#f0f2f3;font-weight:650}.page-content td,.page-content th{padding:12px 16px;border-bottom:1px solid #e2e6e9;vertical-align:top}\n.page-content pre{padding:22px 24px;background:#172b43;border-radius:12px;color:#e6edf4;line-height:1.7;overflow:auto;font-size:12px}.page-content code{font-family:ui-monospace,SFMono-Regular,monospace;font-size:.87em}.page-content :not(pre)>code{background:#edf0f2;color:#456079;border-radius:4px;padding:2px 5px}\n.page-content img{display:block;max-width:100%;height:auto;border-radius:16px;margin:28px 0}\n.site-footer{max-width:720px;border-top:1px solid #e1e5e8;margin-top:52px;padding-top:20px;display:flex;justify-content:space-between;gap:20px;color:#98a1aa;font-size:10px;letter-spacing:.02em}\n@media(max-width:760px){.site-header{height:72px;padding:0 24px}.site-label{font-size:9px}.site-shell{display:block}.site-sidebar{border-right:0;border-bottom:1px solid #e3e5e6;padding:24px}.nav-label{margin-bottom:12px}.sidebar-note{display:none}.site-navigation>ul{display:flex;flex-wrap:wrap;gap:8px 22px}.site-navigation ul ul{margin:5px 0 0}.site-main{padding:36px 24px 48px}.page-title{margin-bottom:24px}.page-content{font-size:14px}.page-content>p:first-child{font-size:16px}.page-content td,.page-content th{padding:10px}.site-footer{margin-top:36px}}\n",
      "metadata": {
        "intent": "Shared responsive documentation shell; content stays in Markdown files",
        "role": "site-template"
      },
