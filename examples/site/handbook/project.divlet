  "frames": [
    {
      "id": "docs-template",
      "name": "Fieldnotes · shared template",
      "version": 4,
      "artboard": {
        "x": 80,
        "y": 80,
        "width": 1120,
        "height": 980
      },
      "rootId": "fieldnotes-root",
      "tokens": {},
      "css": ":root {\n  color-scheme: light;\n}\n\n* {\n  box-sizing: border-box;\n}\n\n.fieldnotes {\n  min-height: 100vh;\n  background: #fbfaf7;\n  color: #243447;\n  font: 16px/1.7 system-ui, sans-serif;\n}\n\n.site-header {\n  height: 84px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 0 clamp(24px, 5vw, 72px);\n  border-bottom: 1px solid #e3e5e6;\n  background: #fffefa;\n}\n\n.site-brand {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  color: #172b43;\n  text-decoration: none;\n  font-weight: 740;\n  letter-spacing: -.04em;\n  font-size: 21px;\n}\n\n.site-brand img {\n  width: 32px;\n  height: 32px;\n}\n\n.site-label {\n  font-size: 11px;\n  font-weight: 650;\n  letter-spacing: .12em;\n  text-transform: uppercase;\n  color: #7c8997;\n}\n\n.site-shell {\n  display: grid;\n  grid-template-columns: 240px minmax(0, 1fr);\n  max-width: 1216px;\n  margin: auto;\n  min-height: calc(100vh - 84px);\n}\n\n.site-sidebar {\n  padding: 48px 28px 40px 36px;\n  border-right: 1px solid #e3e5e6;\n}\n\n.nav-label {\n  margin: 0 0 20px;\n  color: #8a95a0;\n  font-size: 10px;\n  font-weight: 750;\n  letter-spacing: .16em;\n  text-transform: uppercase;\n}\n\n.site-navigation ul {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n}\n\n.site-navigation ul ul {\n  margin: 8px 0 16px;\n  padding-left: 14px;\n  border-left: 1px solid #d9e0e7;\n}\n\n.site-navigation li {\n  margin: 7px 0;\n}\n\n.site-navigation a {\n  color: #63758a;\n  text-decoration: none;\n  font-size: 13px;\n  line-height: 1.6;\n  display: block;\n  padding: 3px 0;\n}\n\n.site-navigation a:hover {\n  color: #172b43;\n  text-decoration: underline;\n  text-underline-offset: 4px;\n}\n\n.site-navigation a[aria-current=\"page\"] {\n  color: #172b43;\n  font-weight: 700;\n}\n\n.sidebar-note {\n  margin-top: 48px;\n  color: #96a0aa;\n  font-size: 11px;\n  line-height: 1.7;\n}\n\n.site-main {\n  min-width: 0;\n  padding: 54px clamp(28px, 5vw, 76px) 64px;\n}\n\n.page-eyebrow {\n  display: flex;\n  align-items: center;\n  gap: 9px;\n  color: #a27b45;\n  font-size: 10px;\n  font-weight: 750;\n  letter-spacing: .14em;\n  text-transform: uppercase;\n  margin: 0 0 14px;\n}\n\n.page-eyebrow span {\n  display: block;\n  width: 20px;\n  height: 1px;\n  background: #b89868;\n}\n\n.page-title {\n  font-size: clamp(31px, 4vw, 46px);\n  line-height: 1.15;\n  letter-spacing: -.05em;\n  font-weight: 690;\n  color: #172b43;\n  margin: 0 0 32px;\n  max-width: 680px;\n}\n\n.page-content {\n  max-width: 720px;\n  color: #596b7f;\n  font-size: 15px;\n  line-height: 1.85;\n  overflow-wrap: anywhere;\n}\n\n.page-content>p:first-child {\n  font-size: 17px;\n  line-height: 1.8;\n  color: #6b7b8d;\n  margin-bottom: 28px;\n}\n\n.page-content h1,\n.page-content h2,\n.page-content h3 {\n  color: #24384e;\n  letter-spacing: -.025em;\n  line-height: 1.35;\n  scroll-margin-top: 24px;\n}\n\n.page-content h1 {\n  font-size: 30px;\n}\n\n.page-content h2 {\n  font-size: 21px;\n  margin: 38px 0 12px;\n}\n\n.page-content h3 {\n  font-size: 17px;\n  margin: 28px 0 10px;\n}\n\n.page-content p {\n  margin: 0 0 18px;\n}\n\n.page-content strong {\n  color: #344c65;\n  font-weight: 650;\n}\n\n.page-content a {\n  color: #386b9c;\n  text-decoration: underline;\n  text-decoration-color: #c3d3e2;\n  text-underline-offset: 3px;\n}\n\n.page-content a:hover {\n  color: #172b43;\n  text-decoration-color: currentColor;\n}\n\n.page-content ul,\n.page-content ol {\n  padding-left: 22px;\n  margin: 0 0 22px;\n}\n\n.page-content li {\n  padding-left: 3px;\n  margin: 7px 0;\n}\n\n.page-content blockquote {\n  margin: 28px 0;\n  padding: 10px 22px;\n  border-left: 3px solid #c6ab85;\n  background: #f3f0e9;\n  color: #7a776f;\n  border-radius: 0 8px 8px 0;\n}\n\n.page-content blockquote p {\n  margin: 0;\n}\n\n.page-content table {\n  border-collapse: collapse;\n  width: 100%;\n  margin: 22px 0 28px;\n  font-size: 13px;\n}\n\n.page-content th {\n  text-align: left;\n  color: #53677d;\n  background: #f0f2f3;\n  font-weight: 650;\n}\n\n.page-content td,\n.page-content th {\n  padding: 12px 16px;\n  border-bottom: 1px solid #e2e6e9;\n  vertical-align: top;\n}\n\n.page-content pre {\n  padding: 22px 24px;\n  background: #172b43;\n  border-radius: 12px;\n  color: #e6edf4;\n  line-height: 1.7;\n  overflow: auto;\n  font-size: 12px;\n}\n\n.page-content code {\n  font-family: ui-monospace, SFMono-Regular, monospace;\n  font-size: .87em;\n}\n\n.page-content :not(pre)>code {\n  background: #edf0f2;\n  color: #456079;\n  border-radius: 4px;\n  padding: 2px 5px;\n}\n\n.page-content img {\n  display: block;\n  max-width: 100%;\n  height: auto;\n  border-radius: 16px;\n  margin: 28px 0;\n}\n\n.site-footer {\n  max-width: 720px;\n  border-top: 1px solid #e1e5e8;\n  margin-top: 52px;\n  padding-top: 20px;\n  display: flex;\n  justify-content: space-between;\n  gap: 20px;\n  color: #98a1aa;\n  font-size: 10px;\n  letter-spacing: .02em;\n}\n\n@media (max-width: 760px) {\n  .site-header {\n    height: 72px;\n    padding: 0 24px;\n  }\n  .site-label {\n    font-size: 9px;\n  }\n  .site-shell {\n    display: block;\n  }\n  .site-sidebar {\n    border-right: 0;\n    border-bottom: 1px solid #e3e5e6;\n    padding: 24px;\n  }\n  .nav-label {\n    margin-bottom: 12px;\n  }\n  .sidebar-note {\n    display: none;\n  }\n  .site-navigation>ul {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 8px 22px;\n  }\n  .site-navigation ul ul {\n    margin: 5px 0 0;\n  }\n  .site-main {\n    padding: 36px 24px 48px;\n  }\n  .page-title {\n    margin-bottom: 24px;\n  }\n  .page-content {\n    font-size: 14px;\n  }\n  .page-content>p:first-child {\n    font-size: 16px;\n  }\n  .page-content td,\n  .page-content th {\n    padding: 10px;\n  }\n  .site-footer {\n    margin-top: 36px;\n  }\n}\n",
      "metadata": {
        "intent": "Shared responsive documentation shell; content stays in Markdown files",
        "role": "site-template"
      },
