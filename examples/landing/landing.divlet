  "frames": [
    {
      "id": "index",
      "name": "divlet — a layout board for agents",
      "head": {
        "description": "divlet is a local browser layout board for coding agents: live frames of real HTML and CSS, reusable components, and the same validated tools through Pi, MCP or the board running in your browser.",
        "icon": "data:image/svg+xml;base64,"
      },
      "version": 14,
      "artboard": {
        "x": 80,
        "y": 80,
        "width": 1280,
        "height": 4300
      },
      "rootId": "top",
      "tokens": {},
      "css": "@layer theme, base, components, utilities;\n@layer base {\n/* Authored in examples/landing/landing.divlet. Everything on the page is a Tailwind utility; this layer only defines the\n   palette for both colour schemes. The project's colour tokens point at these variables, so bg-panel, text-muted and the\n   rest follow the scheme. */\n:root {\n  color-scheme: light dark;\n  --paper: #f7f5f1;\n  --ink: #17161a;\n  --muted: #5f5b57;\n  --faint: #8d8781;\n  --hair: #e2ddd5;\n  --panel: #fffefc;\n  --accent: #5b5bf0;\n  --accent-ink: #4646d8;\n  --accent-soft: #ebebfd;\n  --code: #2a2740;\n  --code-ink: #ece9ff;\n  --shadow: 0 12px 28px -18px rgba(23, 22, 26, .45);\n  --shadow-lift: 0 28px 60px -30px rgba(40, 36, 90, .55);\n}\n@media (prefers-color-scheme: dark) {\n  :root {\n    --paper: #14131a;\n    --ink: #f1eef7;\n    --muted: #a9a4b3;\n    --faint: #7d7887;\n    --hair: #2b2833;\n    --panel: #1b1a22;\n    --accent: #8e8eff;\n    --accent-ink: #a5a5ff;\n    --accent-soft: #262544;\n    --code: #100f16;\n    --code-ink: #dcd8ff;\n    --shadow: 0 18px 34px -22px rgba(0, 0, 0, .8);\n    --shadow-lift: 0 30px 60px -28px rgba(0, 0, 0, .9);\n  }\n}\nbody { margin: 0; background: var(--paper); color: var(--ink); font: 16px/1.6 -apple-system, BlinkMacSystemFont, \"Segoe UI\", Inter, system-ui, sans-serif; -webkit-font-smoothing: antialiased; }\n}",
      "metadata": {},
