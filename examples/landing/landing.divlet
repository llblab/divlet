        "text-474": {
          "id": "text-474",
          "type": "text",
          "content": "Static HTML pages open through the native importer, Pencil files convert through a plugin, and Markdown folders become routed sites. A source is never rewritten: divlet creates a sibling ",
          "metadata": {}
        },
