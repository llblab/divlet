{
  "schemaVersion": 1,
  "name": "divlet landing",
  "version": 1,
  "tokens": {
    "--color-paper": "var(--paper)",
    "--color-ink": "var(--ink)",
    "--color-muted": "var(--muted)",
    "--color-faint": "var(--faint)",
    "--color-hair": "var(--hair)",
    "--color-panel": "var(--panel)",
    "--color-accent": "var(--accent)",
    "--color-accent-ink": "var(--accent-ink)",
    "--color-accent-soft": "var(--accent-soft)",
    "--color-code": "var(--code)",
    "--color-code-ink": "var(--code-ink)"
  },
  "css": "",
  "metadata": {},
  "frames": [
    {
      "id": "index",
      "name": "divlet — a layout board for agents",
      "head": {
        "description": "divlet is a local browser layout board for coding agents: live frames of real HTML and CSS, reusable components, and the same validated tools through Pi, MCP or the board running in your browser.",
        "icon": "data:image/svg+xml;base64,"
      },
      "version": 9,
      "artboard": {
        "x": 80,
        "y": 80,
        "width": 1280,
        "height": 4130
      },
      "rootId": "top",
      "tokens": {},
      "css": "/* Authored in examples/landing/landing.divlet; this stylesheet travels with its frame. The page's own variables back the Tailwind colour tokens, so utilities such as bg-panel follow the colour scheme. */\n:root {\n  color-scheme: light dark;\n  --paper: #f7f5f1;\n  --ink: #17161a;\n  --muted: #5f5b57;\n  --faint: #8d8781;\n  --hair: #e2ddd5;\n  --panel: #fffefc;\n  --accent: #5b5bf0;\n  --accent-ink: #4646d8;\n  --accent-soft: #ebebfd;\n  --code: #2a2740;\n  --code-ink: #ece9ff;\n  --green: #123524;\n  --gold: #d7b474;\n  --shadow: 0 12px 28px -18px rgba(23, 22, 26, .45);\n  --radius: 18px;\n  --radius-inner: 12px;\n}\n@media (prefers-color-scheme: dark) {\n  :root {\n    --paper: #14131a;\n    --ink: #f1eef7;\n    --muted: #a9a4b3;\n    --faint: #7d7887;\n    --hair: #2b2833;\n    --panel: #1b1a22;\n    --accent: #8e8eff;\n    --accent-ink: #a5a5ff;\n    --accent-soft: #262544;\n    --code: #100f16;\n    --code-ink: #dcd8ff;\n    --shadow: 0 18px 34px -22px rgba(0, 0, 0, .8);\n  }\n}\n\n* { box-sizing: border-box; }\nhtml { -webkit-text-size-adjust: 100%; }\nbody {\n  margin: 0;\n  background: var(--paper);\n  color: var(--ink);\n  font: 16px/1.6 -apple-system, BlinkMacSystemFont, \"Segoe UI\", Inter, system-ui, sans-serif;\n  -webkit-font-smoothing: antialiased;\n}\nmain { width: min(940px, 100% - 40px); margin: 0 auto; padding: 28px 0 56px; overflow-wrap: anywhere; }\nh1, h2, h3 { letter-spacing: -.02em; line-height: 1.15; margin: 0; }\nh1 { font-size: clamp(30px, 5.4vw, 50px); font-weight: 660; }\nh2 { font-size: clamp(20px, 3vw, 26px); font-weight: 640; }\nh3 { font-size: 16px; font-weight: 640; }\np { margin: 0; }\ncode { font: .92em ui-monospace, SFMono-Regular, Menlo, monospace; }\na { color: inherit; }\n\n/* ---- top bar ------------------------------------------------------------------------------------ */\n.top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 56px; }\n.mark { display: inline-flex; align-items: center; gap: 8px; font-weight: 640; letter-spacing: -.01em; text-decoration: none; }\n.mark svg { width: 24px; height: 24px; fill: none; color: var(--accent); stroke: currentColor; stroke-width: 1.5; stroke-linejoin: round; stroke-linecap: round; }\n.top nav { display: flex; flex-wrap: wrap; gap: 4px; }\n.top nav a { padding: 6px 10px; border-radius: 9px; color: var(--muted); font-size: 13.5px; text-decoration: none; }\n.top nav a:hover { background: var(--panel); color: var(--ink); box-shadow: var(--shadow); }\n\n/* ---- hero --------------------------------------------------------------------------------------- */\n.hero { display: grid; gap: 16px; max-width: 42em; }\n.eyebrow { color: var(--accent); font-size: 12.5px; font-weight: 640; letter-spacing: .1em; text-transform: uppercase; }\n.lede { color: var(--muted); font-size: clamp(15px, 1.9vw, 17.5px); }\n.cta { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; margin-top: 8px; }\n.button { display: inline-flex; align-items: center; height: 42px; padding: 0 20px; border-radius: 999px; background: var(--accent); color: #fff; font-size: 14.5px; font-weight: 620; text-decoration: none; }\n.button:hover { background: var(--accent-ink); }\n.quiet-link { color: var(--muted); font-size: 14px; text-decoration: none; border-bottom: 1px solid var(--hair); }\n.quiet-link:hover { color: var(--ink); border-color: var(--accent); }\n\n/* ---- what it is: one edit as the agent and the board see it, beside what that means ----------- */\n.note { color: var(--faint); font-size: 13px; }\n.board { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 28px; align-items: start; margin: 64px 0; }\n.exchange { display: grid; gap: 8px; margin: 0; padding: 18px; border-radius: var(--radius); background: var(--code); color: var(--code-ink); box-shadow: var(--shadow); font: 12.5px/1.5 ui-monospace, SFMono-Regular, Menlo, monospace; }\n.exchange figcaption { margin-bottom: 4px; color: #a9a4c9; font: 12px/1.4 -apple-system, BlinkMacSystemFont, \"Segoe UI\", Inter, system-ui, sans-serif; }\n.row { display: grid; grid-template-columns: 6ch 13ch minmax(0, 1fr); gap: 10px; align-items: baseline; }\n.who { color: #8d88b0; }\n.call { color: #fff; font-weight: 600; }\n.arg { color: #cfcaf2; }\n.row.ok .call { color: #8fe0b0; }\n.row.no .call { color: #ffb4a8; }\n.facts { display: grid; gap: 16px; margin: 0; padding: 0; list-style: none; }\n.facts li { display: grid; gap: 2px; }\n.facts b { font-size: 14.5px; font-weight: 640; }\n.facts span { color: var(--muted); font-size: 13.5px; }\n\n/* ---- steps -------------------------------------------------------------------------------------- */\n.how { margin: 64px 0; }\n.steps { display: grid; gap: 14px; margin: 22px 0 0; padding: 0; list-style: none; }\n.steps li { display: grid; grid-template-columns: 28px minmax(0, 1fr); gap: 12px; align-items: start; }\n.step { display: grid; place-items: center; width: 26px; height: 26px; border-radius: 999px; background: var(--accent-soft); color: var(--accent); font-size: 12.5px; font-weight: 660; }\n.steps b { font-size: 14.5px; }\n.steps p { color: var(--muted); font-size: 13.5px; }\n\n/* ---- formats, tools and boundaries -------------------------------------------------------------- */\n.formats, .agents, .try, .limits { margin: 64px 0; }\n.prose { color: var(--muted); font-size: 14.5px; max-width: 44em; margin-top: 12px; }\n.prose.small { font-size: 13px; margin-top: 16px; }\n.chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px; }\n.chips span { padding: 6px 12px; border: 1px solid var(--hair); border-radius: 999px; background: var(--panel); color: var(--muted); font-size: 12.5px; }\n.chips code { color: var(--ink); }\n\n/* ---- trying and installing ---------------------------------------------------------------------- */\n.start { margin: 64px 0; }\n.cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr)); gap: 16px; margin-top: 20px; }\n.card { display: grid; gap: 8px; padding: 18px; border: 1px solid var(--hair); border-radius: var(--radius); background: var(--panel); box-shadow: var(--shadow); }\n.card p { color: var(--muted); font-size: 13.5px; }\n.card pre { margin: 4px 0 0; padding: 12px; border-radius: var(--radius-inner); background: var(--code); color: var(--code-ink); font-size: 12.5px; white-space: pre-wrap; overflow-wrap: normal; word-break: normal; overflow-x: auto; }\n/* Commands wrap between words, never inside a flag; a token wider than the card scrolls inside it. */\n\n.tools { display: grid; list-style: none; padding: 0; grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr)); gap: 10px 24px; margin: 20px 0 0; }\n.tools li { display: grid; gap: 2px; padding-top: 10px; border-top: 1px solid var(--hair); }\n.tools code { color: var(--accent-ink); font-size: 13px; font-weight: 600; }\n.tools span { color: var(--muted); font-size: 13.5px; }\n.limits ul { display: grid; gap: 8px; margin: 16px 0 0; padding: 0; list-style: none; max-width: 44em; }\n.limits li { color: var(--muted); font-size: 14px; }\n.limits b { color: var(--ink); font-weight: 620; }\n\nfooter { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px; margin-top: 56px; padding-top: 18px; border-top: 1px solid var(--hair); color: var(--faint); font-size: 12.5px; }\n\n/* ---- the board, as a picture ------------------------------------------------------------------- */\n.stage { margin: 56px 0 0; }\n.stage-canvas { position: relative; display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(0, .5fr) minmax(0, .8fr); gap: 18px; align-items: start; padding: 22px; border: 1px solid var(--hair); border-radius: 24px; background-color: var(--panel); background-image: radial-gradient(circle at 1px 1px, var(--hair) 1px, transparent 0); background-size: 18px 18px; box-shadow: var(--shadow); overflow: hidden; }\n.stage figcaption { margin-top: 12px; color: var(--faint); font-size: 13px; text-align: center; }\n.artboard { position: relative; display: grid; gap: 8px; align-content: start; }\n.artboard-name { display: flex; gap: 8px; align-items: baseline; white-space: nowrap; color: var(--muted); font-size: 11.5px; font-weight: 600; }\n.artboard-name i { color: var(--faint); font-style: normal; font-weight: 500; }\n.page { display: grid; gap: 14px; padding: 12px; border: 1.5px solid var(--accent); border-radius: 8px; background: var(--paper); box-shadow: 0 0 0 4px var(--accent-soft); }\n.page-bar { display: flex; align-items: center; gap: 8px; }\n.page-bar b { width: 14px; height: 14px; margin-right: auto; border-radius: 4px; background: var(--accent); }\n.page-bar span { width: 26px; height: 5px; border-radius: 3px; background: var(--hair); }\n.page-hero { display: grid; gap: 7px; padding: 10px 0 4px; }\n.page-hero em { width: 34%; height: 5px; border-radius: 3px; background: var(--accent); opacity: .7; }\n.page-hero strong { height: 13px; border-radius: 4px; background: var(--ink); }\n.page-hero strong.short { width: 68%; }\n.page-hero u { width: 52%; height: 6px; margin-top: 4px; border-radius: 3px; background: var(--hair); }\n.page-row { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }\n.page-row.stack { grid-template-columns: 1fr; }\n.page-row i { height: 46px; border: 1px solid var(--hair); border-radius: 7px; background: var(--panel); }\n.phone .page { padding: 10px; }\n.phone .page-row i { height: 32px; }\n.inspector { display: grid; gap: 8px; align-content: start; padding: 12px; border: 1px solid var(--hair); border-radius: 14px; background: var(--paper); box-shadow: var(--shadow); font-size: 11.5px; }\n.inspector p { margin: 0; }\n.inspector-head { display: flex; gap: 6px; align-items: center; color: var(--faint); font: 11.5px ui-monospace, SFMono-Regular, Menlo, monospace; }\n.inspector-head span { padding: 1px 7px; border-radius: 6px; background: var(--accent-soft); color: var(--accent-ink); font-weight: 600; }\n.inspector-title { margin-top: 4px; color: var(--ink); font-weight: 640; }\n.chips-mock { display: flex; flex-wrap: wrap; gap: 4px; }\n.chips-mock span { padding: 2px 8px; border-radius: 6px; background: var(--accent-soft); color: var(--accent-ink); font: 10.5px ui-monospace, SFMono-Regular, Menlo, monospace; }\n.boxmodel-mock div { display: grid; place-items: center; padding: 9px; border: 1px dashed var(--faint); border-radius: 5px; background: color-mix(in srgb, var(--gold) 28%, transparent); }\n.boxmodel-mock div div { background: color-mix(in srgb, var(--accent) 16%, transparent); border-style: solid; border-color: var(--hair); }\n.boxmodel-mock div div div { background: color-mix(in srgb, var(--accent) 30%, transparent); }\n.boxmodel-mock span { padding: 3px 10px; border-radius: 4px; background: var(--paper); color: var(--ink); font: 11px ui-monospace, SFMono-Regular, Menlo, monospace; }\n.field-mock { display: grid; grid-template-columns: auto 18px 1fr; gap: 8px; align-items: center; padding: 6px 8px; border: 1px solid var(--hair); border-radius: 8px; background: var(--panel); }\n.field-mock span { color: var(--muted); }\n.field-mock i { width: 18px; height: 18px; border-radius: 5px; background: var(--ink); }\n.field-mock code { color: var(--ink); }\n\n/* ---- plain CSS first, Tailwind where it fits ------------------------------------------------------ */\n.styles { margin: 72px 0; }\n.styles h2 { margin-top: 6px; }\n.flow { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr) auto minmax(0, 1fr); gap: 12px; align-items: stretch; margin-top: 26px; }\n.flow-step { display: grid; gap: 10px; align-content: start; box-shadow: var(--shadow); }\n.flow-label { color: var(--faint); font-size: 11.5px; font-weight: 640; letter-spacing: .08em; text-transform: uppercase; }\n.flow-arrow { align-self: center; color: var(--faint); font-size: 20px; }\n.flow-control { display: flex; align-items: baseline; gap: 8px; padding: 8px 12px; border: 1px solid var(--hair); border-radius: 10px; background: var(--paper); font-size: 13.5px; }\n.flow-control span { margin-right: auto; color: var(--muted); }\n.flow-control b { font: 600 14px ui-monospace, SFMono-Regular, Menlo, monospace; }\n.flow-control i { color: var(--faint); font-size: 12px; font-style: normal; }\n.flow-code { padding: 9px 12px; border-radius: 10px; background: var(--code); color: var(--code-ink); font-size: 13.5px; }\n.points { display: grid; gap: 12px; margin: 26px 0 0; padding: 0; list-style: none; max-width: 46em; }\n.points li { color: var(--muted); font-size: 14.5px; }\n.points b { color: var(--ink); font-weight: 640; }\n.points code { padding: 1px 6px; border-radius: 6px; background: var(--accent-soft); color: var(--accent-ink); }\n.styles .note { margin-top: 18px; }\n\n@media (max-width: 720px) {\n  .stage-canvas { grid-template-columns: minmax(0, 1fr) minmax(0, .5fr); }\n  .inspector { grid-column: 1 / -1; }\n  .artboard-name i { display: none; }\n  .flow { grid-template-columns: 1fr; }\n  .flow-arrow { justify-self: center; transform: rotate(90deg); }\n  .board { grid-template-columns: 1fr; }\n  .row { grid-template-columns: 6ch minmax(0, 1fr); }\n  .row .arg { grid-column: 2; }\n  .top { margin-bottom: 36px; }\n}\n",
