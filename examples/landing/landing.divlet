        "text-33": {
          "id": "text-33",
          "type": "text",
          "content": "divlet gives your agent a board of real web pages. Point at what should change; the agent edits through validated tools, and you watch every accepted change land — versioned, logged and one Undo away.",
          "metadata": {}
        },
        "text-34": {
          "id": "text-34",
          "type": "text",
          "content": "\n    ",
          "metadata": {}
        },
        "node-35": {
          "id": "node-35",
