{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rewriteRelativeImportExtensions": true,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "outDir": "dist",
    "rootDir": "."
  },
  "exclude": [
    "node_modules",
    "**/dist/**",
    "web",
    "examples",
    "**/tests/**"
  ]
}
