{
  "name": "@divlet/core",
  "version": "0.0.5",
  "description": "A browser layout board for agents: one project file, live frames, reusable components; the same tools through Pi and MCP",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/llblab/divlet.git"
  },
  "homepage": "https://llblab.github.io/divlet",
  "bugs": {
    "url": "https://github.com/llblab/divlet/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "components",
    "design",
    "layout",
    "tailwindcss",
    "mcp",
    "model-context-protocol"
  ],
  "exports": {
    ".": {
      "divlet-source": "./core/index.js",
      "default": "./dist/core/index.js"
    },
    "./runtime": {
      "divlet-source": "./core/lib/runtime.js",
      "default": "./dist/core/lib/runtime.js"
    },
    "./codec": {
      "divlet-source": "./core/lib/codec.ts",
      "default": "./dist/core/lib/codec.js"
    },
    "./model": {
      "divlet-source": "./core/lib/model.ts",
      "default": "./dist/core/lib/model.js"
    },
    "./project": {
      "divlet-source": "./core/lib/project.ts",
      "default": "./dist/core/lib/project.js"
    },
    "./contract": {
      "divlet-source": "./core/lib/contract.ts",
      "default": "./dist/core/lib/contract.js"
    },
    "./boards": {
      "divlet-source": "./core/lib/boards.ts",
      "default": "./dist/core/lib/boards.js"
    },
    "./plugins": {
      "divlet-source": "./core/lib/plugins.ts",
      "default": "./dist/core/lib/plugins.js"
    },
    "./engine": {
      "divlet-source": "./core/lib/engine.ts",
      "default": "./dist/core/lib/engine.js"
    },
    "./browser-mcp": {
      "divlet-source": "./core/lib/browser-mcp.ts",
      "default": "./dist/core/lib/browser-mcp.js"
    },
    "./skill": "./skills/divlet/SKILL.md"
  },
  "browser": {
    "./core/lib/model-styles.ts": "./core/lib/browser-styles.ts",
    "./dist/core/lib/model-styles.js": "./dist/core/lib/browser-styles.js",
    "./core/lib/media-type.ts": "./core/lib/browser-media-type.ts",
    "./dist/core/lib/media-type.js": "./dist/core/lib/browser-media-type.js"
  },
  "files": [
    "dist",
    "skills",
    "docs",
    "examples",
    "README.md",
    "AGENTS.md",
    "BACKLOG.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node scripts/source.mjs ./cli/index.js",
    "demo": "node scripts/source.mjs ./cli/index.js ./examples/landing/landing.divlet",
    "demo:site": "node scripts/source.mjs ./cli/index.js --cwd ./examples/handbook",
    "pretest": "npm run typecheck",
    "test": "node scripts/source.mjs --test",
    "test:format": "node scripts/source.mjs --test core/tests/format.test.js core/tests/format-types.test.ts",
    "test:format:audit": "node scripts/source.mjs core/tests/format-audit.mjs",
    "test:browser": "node scripts/source.mjs web/tests/run.mjs",
    "test:browser:kernel": "node scripts/source.mjs web/tests/validation.mjs",
    "test:responsive": "node scripts/source.mjs web/tests/responsive.mjs",
    "test:layout": "node scripts/source.mjs web/tests/layout-wrap.mjs",
    "test:site": "node scripts/source.mjs web/tests/site.mjs",
    "test:fullscreen": "node scripts/source.mjs web/tests/fullscreen.mjs",
    "test:interact": "node scripts/source.mjs web/tests/interact.mjs",
    "test:preview-links": "node scripts/source.mjs web/tests/preview-links.mjs",
    "test:text-edit-render": "node scripts/source.mjs web/tests/text-edit-render.mjs",
    "test:filenames": "node scripts/source.mjs --test core/tests/frame-filenames.test.js",
    "test:selection-completion": "node scripts/source.mjs web/tests/selection-completion.mjs",
    "test:controls": "node scripts/source.mjs web/tests/selection-completion.mjs && node scripts/source.mjs web/tests/size-editor.mjs && node scripts/source.mjs web/tests/controls.mjs",
    "test:history": "node scripts/source.mjs --test core/tests/history-line.test.js core/tests/history.test.js core/tests/server.test.js && node scripts/source.mjs web/tests/history.mjs",
    "test:settings": "node scripts/source.mjs web/tests/settings.mjs",
    "test:defaults": "node scripts/source.mjs web/tests/native-default.mjs",
    "test:browser:all": "node scripts/source.mjs web/tests/validation.mjs && node scripts/source.mjs web/tests/run.mjs && node scripts/source.mjs web/tests/responsive.mjs && node scripts/source.mjs web/tests/layout-wrap.mjs && node scripts/source.mjs web/tests/site.mjs && node scripts/source.mjs web/tests/fullscreen.mjs && node scripts/source.mjs web/tests/settings.mjs && node scripts/source.mjs web/tests/interact.mjs && node scripts/source.mjs web/tests/selection-completion.mjs && node scripts/source.mjs web/tests/size-editor.mjs && node scripts/source.mjs web/tests/controls.mjs && node scripts/source.mjs web/tests/history.mjs && node scripts/source.mjs web/tests/features.mjs && node scripts/source.mjs web/tests/agent-status.mjs && node scripts/source.mjs web/tests/chat.mjs && node scripts/source.mjs web/tests/spacing.mjs && node scripts/source.mjs web/tests/toolbars.mjs && node scripts/source.mjs web/tests/appearance.mjs && node scripts/source.mjs web/tests/font-containers.mjs && node scripts/source.mjs web/tests/reimport.mjs && node scripts/source.mjs web/tests/chrome.mjs && node scripts/source.mjs web/tests/fluid.mjs && node scripts/source.mjs web/tests/snapshots.mjs && node scripts/source.mjs web/tests/launcher.mjs && node scripts/source.mjs web/tests/launcher-errors.mjs && node scripts/source.mjs web/tests/native-collections.mjs && node scripts/source.mjs web/tests/projects.mjs && node scripts/source.mjs web/tests/security.mjs && node scripts/source.mjs web/tests/static.mjs && node scripts/source.mjs web/tests/native-default.mjs && node scripts/source.mjs web/tests/landing.mjs && node scripts/source.mjs web/tests/preview-links.mjs && node scripts/source.mjs web/tests/text-edit-render.mjs && node scripts/source.mjs web/tests/toast-priority.mjs && node scripts/source.mjs web/tests/browser-mcp.mjs && node scripts/source.mjs web/tests/pages.mjs",
    "test:toast-priority": "node scripts/source.mjs web/tests/toast-priority.mjs",
    "test:features": "node scripts/source.mjs web/tests/features.mjs",
    "test:chat": "node scripts/source.mjs web/tests/chat.mjs",
    "test:spacing": "node scripts/source.mjs web/tests/spacing.mjs",
    "test:chrome": "node scripts/source.mjs web/tests/chrome.mjs",
    "test:fluid": "node scripts/source.mjs web/tests/fluid.mjs",
    "test:snapshots": "node scripts/source.mjs web/tests/snapshots.mjs",
    "test:font-containers": "node scripts/source.mjs web/tests/font-containers.mjs",
    "test:size-editor": "node scripts/source.mjs web/tests/size-editor.mjs",
    "test:ellipses": "node scripts/source.mjs --test core/tests/native-ellipse.test.js",
    "test:paths": "node scripts/source.mjs --test core/tests/native-path.test.js",
    "test:launcher": "node scripts/source.mjs web/tests/launcher.mjs && node scripts/source.mjs web/tests/launcher-errors.mjs && node scripts/source.mjs web/tests/native-collections.mjs",
    "test:projects": "node scripts/source.mjs web/tests/projects.mjs",
    "test:security": "node scripts/source.mjs web/tests/security.mjs",
    "test:static": "node scripts/source.mjs web/tests/static.mjs",
    "test:source": "node scripts/source.mjs web/tests/native-collections.mjs && node scripts/source.mjs web/tests/native-default.mjs",
    "test:release": "node core/tests/release/install-smoke.mjs",
    "test:release:pi": "node core/tests/release/install-smoke.mjs --pi",
    "test:pen-fidelity": "node scripts/source.mjs plugins/pen/tests/fidelity.mjs",
    "test:pi": "node scripts/source.mjs pi/tests/e2e/pi.mjs",
    "test:mcp": "node scripts/source.mjs --test mcp/tests/*.test.js",
    "test:contract": "node scripts/source.mjs --test core/tests/contract.test.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json",
    "landing:hash": "node scripts/landing-hash.mjs",
    "landing:build": "node scripts/landing-build.mjs",
    "landing:check": "node scripts/landing-build.mjs --check",
    "test:landing": "node scripts/source.mjs web/tests/landing.mjs",
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "test:browser-mcp": "node scripts/source.mjs web/tests/browser-mcp.mjs",
    "test:pages": "node scripts/source.mjs web/tests/pages.mjs",
    "pages:build": "node scripts/source.mjs scripts/pages-build.mjs",
    "test:connect": "node scripts/source.mjs mcp/tests/connect.e2e.mjs"
  },
  "dependencies": {
    "@divlet/web": "0.0.5",
    "@tailwindcss/node": "^4.1.0",
    "@xmldom/xmldom": "0.9.12",
    "lucide-static": "1.67.0",
    "marked": "^18.1.2",
    "parse5": "^8.0.0",
    "postcss": "^8.5.6",
    "postcss-value-parser": "^4.2.0",
    "svg-pathdata": "8.0.0",
    "tailwindcss": "^4.1.0",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "playwright-core": ">=1.50.0"
  },
  "peerDependenciesMeta": {
    "playwright-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^22.20.5",
    "esbuild": "0.28.2",
    "playwright": "^1.62.1",
    "typebox": "^1.0.0",
    "typescript": "5.9"
  },
  "workspaces": [
    ".",
    "web",
    "cli",
    "mcp",
    "pi",
    "plugins/*"
  ]
}
